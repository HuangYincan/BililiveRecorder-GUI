{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BililiveRecorder GUI",
  "version": "2.20.0",
  "identifier": "org.danmuji.bililiverecorder-gui",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["sidecar/**/*"],
    "license": "GPL-3.0-only",
    "shortDescription": "跨平台录播姬桌面端",
    "longDescription": "启动后自动运行官方 BililiveRecorder CLI，并在唯一主窗口中直接显示其内嵌官方 WebUI。",
    "category": "Utility",
    "copyright": "Copyright © 2026 HuangYincan",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4M0ZEOUJBMzREMEJENUQKUldSZHZkQTB1dGsvS0NBeHNBakp0RUg5aDJjeHBDVG1mL2o1NnYraDZQSDA1M2ZkMVRYNDI2djQK",
      "endpoints": [
        "https://github.com/huangyincan/BililiveRecorder-GUI/releases/latest/download/latest.json"
      ]
    }
  }
}
